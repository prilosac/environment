// Base OpenCode 2 configuration - machine-agnostic settings only.
// NOTE: comments must be full-line "//" to play nice with jq in the merge
{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "*.md", "effect": "allow" },
    { "action": "edit", "resource": "*.py", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "cat *.env", "effect": "deny" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "tail *.env", "effect": "deny" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "head *.env", "effect": "deny" },
    { "action": "shell", "resource": "gh *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git branch*", "effect": "allow" },
    { "action": "shell", "resource": "git branch -d*", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D*", "effect": "ask" },
    { "action": "shell", "resource": "git branch --delete*", "effect": "ask" },
    { "action": "shell", "resource": "git branch -m*", "effect": "ask" },
    { "action": "shell", "resource": "git branch -M*", "effect": "ask" },
    { "action": "shell", "resource": "git branch --move*", "effect": "ask" },
    { "action": "shell", "resource": "git branch -c*", "effect": "ask" },
    { "action": "shell", "resource": "git branch -C*", "effect": "ask" },
    { "action": "shell", "resource": "git branch --copy*", "effect": "ask" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git grep *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git merge-base", "effect": "allow" },
    { "action": "shell", "resource": "git remote show origin", "effect": "allow" },
    { "action": "shell", "resource": "git rev-list", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "uv run pytest*", "effect": "allow" },
    { "action": "shell", "resource": "uv run pyright*", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    // I don't like this one because it could easily be dangerous, but models as of 08-2026 LOVE to use sed to look around
    { "action": "shell", "resource": "sed *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "echo $*", "effect": "ask" },
    { "action": "shell", "resource": "npm run*", "effect": "allow" },
    { "action": "shell", "resource": "npm test", "effect": "allow" },
    { "action": "shell", "resource": "python -m unittest*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "doom_loop", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],
  "agents": {
    "plan": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*.md", "effect": "allow" },
        { "action": "edit", "resource": "*.py", "effect": "ask" }
      ]
    }
  }
}
