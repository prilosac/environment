// Base OpenCode configuration — machine-agnostic settings only.
// NOTE: comments must be full-line "//" to play nice with jq in the merge
{
  "$schema": "https://opencode.ai/config.json",
  // Theme configuration
  "theme": "catppuccin-macchiato",
  "autoupdate": true,
  "permission": {
    "edit": {
      "*": "ask",
      "*.md": "allow",
      "*.py": "ask"
    },
    "bash": {
      "rm *": "deny",
      "*": "ask",
      "cat *": "allow",
      "cat *.env": "deny",
      "tail *": "allow",
      "tail *.env": "deny",
      "ls *": "allow",
      "rg *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "head *.env": "deny",
      "gh *": "ask",
      "gh pr *": "allow",
      "git blame *": "allow",
      "git branch*": "allow",
      "git branch -d*": "ask",
      "git branch -D*": "ask",
      "git branch --delete*": "ask",
      "git branch -m*": "ask",
      "git branch -M*": "ask",
      "git branch --move*": "ask",
      "git branch -c*": "ask",
      "git branch -C*": "ask",
      "git branch --copy*": "ask",
      "git diff *": "allow",
      "git grep *": "allow",
      "git log *": "allow",
      "git merge-base": "allow",
      "git remote show origin": "allow",
      "git rev-list": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "uv run pytest*": "allow",
      "uv run pyright*": "allow",
      "find *": "allow",
      "sed *": "allow", // I don't like this one because it could easily be dangerous, but models as of 08-2026 LOVE to use sed to look around
      "sort *": "allow",
      "echo *": "allow",
      "echo $*": "ask",
      "npm run*": "allow",
      "npm test": "allow",
      "python -m unittest*": "allow"
    },
    "webfetch": "ask",
    "doom_loop": "ask",
    "external_directory": "ask"
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": {
          "*": "deny",
          "*.md": "allow",
          "*.py": "ask"
        }
      }
    }
  }
}
